# API Configuration
# Copy this file to .env and update with your values

# Local development (emulator / same machine)
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Local network — use your PC's LAN IP for a physical phone
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.114:8000/api

# EXPO_PUBLIC_ENABLE_DEBUG_LOGS=true
